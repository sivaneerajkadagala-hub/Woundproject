# Database Configuration
DATABASE_URL=postgresql://wound_user:wound_password_2026@localhost:5432/wound_db
# For SQLite local fallback: sqlite:///./wound_app.db

# JWT Security
# REQUIRED: Generate a strong secret key. Do NOT use the placeholder below in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key-generated-via-secrets-token-hex
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS Origins (comma-separated). No wildcard (*) allowed in production.
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Storage Settings
STORAGE_DIR=./storage

# AI Mesh / Local AI Config (Optional LLM Integration)
AIMESH_BASE_URL=
AIMESH_API_KEY=

# U-Net Segmentation Checkpoint (Optional)
# Path to a pretrained U-Net checkpoint (.pth/.pt) trained on wound segmentation data.
# When set and the file exists, U-Net inference is used. Otherwise, CV color
# segmentation is used as the reliable fallback. The active method is reported
# in every segmentation result and in the /api/health endpoint.
# UNET_CHECKPOINT_PATH=/app/storage/checkpoints/wound_unet_resnet34.pth
